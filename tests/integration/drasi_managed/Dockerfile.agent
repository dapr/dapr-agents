FROM python:3.12.12-slim-bookworm AS build

COPY --from=ghcr.io/astral-sh/uv:0.11.27 /uv /usr/local/bin/uv
RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates git \
    && rm -rf /var/lib/apt/lists

ARG DRASI_CORE_VERSION
ENV UV_PROJECT_ENVIRONMENT=/app/.venv \
    UV_LINK_MODE=copy \
    UV_PYTHON_DOWNLOADS=0 \
    SETUPTOOLS_SCM_PRETEND_VERSION_FOR_DAPR_AGENTS=${DRASI_CORE_VERSION}
WORKDIR /workspace
COPY . .
RUN --mount=type=cache,target=/root/.cache/uv \
    test -n "$DRASI_CORE_VERSION" \
    && uv sync --frozen --no-dev --extra drasi --no-editable \
    && uv pip check --python /app/.venv/bin/python

FROM python:3.12.12-slim-bookworm
ENV PATH="/app/.venv/bin:$PATH" \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1
WORKDIR /app
COPY --from=build /app/.venv /app/.venv
COPY tests/integration/drasi_managed/agent_app.py tests/integration/drasi_managed/model_app.py ./
USER 65532:65532
CMD ["python", "-m", "uvicorn", "agent_app:app", "--host", "0.0.0.0", "--port", "8000"]
